HOST=
PORT=
CORS_ORIGINS=

DB_HOST=
DB_PORT=
DB_NAME=docusum
DB_USER=postgres
DB_PASSWORD=postgres
# Optional override:
# DATABASE_URL=postgresql://postgres:[input URL directionality here]/docusum

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64

# For local pipeline checks without OpenAI:
RAG_USE_FAKE_EMBEDDINGS=true
RAG_USE_FAKE_LLM=true

PASSWORD_HASH_ITERATIONS=600000
